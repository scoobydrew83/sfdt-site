{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Preparing workspace",
            "command": "d=$(jq -r '.cwd // empty'); cd \"${d:-.}\" || exit 0; [ -d node_modules ] || npm ci"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ]
  }
}
